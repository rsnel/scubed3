#!/bin/sh
# "Configure scubed3" in the main menu of partman, always (as "Configure
# software RAID" and "Configure encrypted volumes"): without a partition
# that is used as the base device of scubed3 it says how to make one

. /lib/partman/lib/scubed3-base.sh

db_metaget partman-scubed3/text/configure description
printf "scubed3\t%s\n" "$RET"
