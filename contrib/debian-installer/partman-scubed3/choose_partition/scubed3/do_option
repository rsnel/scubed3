#!/bin/sh
# "Configure scubed3" in the main menu of partman:
#
# 1. the first time: the partition table is written, the base device (the
#    partition with method scubed3) is filled with random data (a new set of
#    macroblocks) or the salt of an existing one is asked, the daemon is
#    started, a key store is made with the boot passphrase (the passphrase
#    that is asked at boot, as for an encrypted disk)
# 2. a menu: create partitions, open existing ones; their keys go into the
#    key store: in the view of the boot passphrase (root always), or in the
#    view of a hidden passphrase (ALL partitions on the base device must be
#    open before finish, and in the key store: in paranoia level 2 and 3 a
#    partition that is not open is destroyed)
# 3. finish: the root file system goes on the partition "root" (with
#    LUKS); the paranoia level is switched, the unclaimed blocks are lent to
#    root (they are given back at the end of the installation, see
#    finish-install.d/08scubed3), LUKS is put on the partitions that get it
#    (their keys are in the key store), the LUKS volumes of the view of the
#    boot passphrase are opened, partman is restarted: they
#    (/dev/mapper/HOSTNAME-NAME) are disks in partman

. /lib/partman/lib/crypto-base.sh
. /lib/partman/lib/scubed3-base.sh

note () {
	db_fset $1 seen false
	db_input critical $1
	db_go || true
}

setup_store () {
	local bases base size m salt iterations
	bases=$(s3_bases)
	if [ -z "$bases" ]; then
		note partman-scubed3/no_base
		return 1
	fi
	if [ $(echo "$bases" | wc -l) -gt 1 ]; then
		note partman-scubed3/too_many_bases
		return 1
	fi

	confirm_changes partman-scubed3 || return 1
	commit_changes partman-scubed3/commit_failed || exit $?

	# the path after the commit
	base=$(s3_bases | cut -f3)
	if ! size=$(s3_size_mib $base) || ! m=$(s3_choose_meso $size); then
		db_subst partman-scubed3/too_large DEVICE "$(humandev $base)"
		note partman-scubed3/too_large
		return 1
	fi

	# the options of the daemon (preseeding can change them, they must be
	# the same forever)
	db_get partman-scubed3/options
	[ "$RET" ] || db_set partman-scubed3/options "-m $m -M $S3MACRO_LOG"
	db_input low partman-scubed3/options || true
	db_go || return 1
	db_get partman-scubed3/options
	echo "$RET" > $S3STATE/options

	db_subst partman-scubed3/store_type DEVICE "$(humandev $base)"
	db_input critical partman-scubed3/store_type
	db_go || return 1
	db_get partman-scubed3/store_type
	if [ "$RET" = new ]; then
		salt=$(s3_random_salt)
		if [ -z "$salt" ]; then
			note partman-scubed3/no_salt
			return 1
		fi
		iterations=$S3DEFAULT_ITERATIONS
		db_subst partman-scubed3/fill DEVICE "$(humandev $base)"
		db_set partman-scubed3/fill true
		db_input critical partman-scubed3/fill
		db_go || return 1
		db_get partman-scubed3/fill
		if [ "$RET" = true ] && ! s3_fill $base; then
			db_subst partman-scubed3/fill_failed DEVICE "$(humandev $base)"
			s3_error partman-scubed3/fill_failed
			return 1
		fi
		db_subst partman-scubed3/salt_note SALT "$salt"
		note partman-scubed3/salt_note
	else
		db_input critical partman-scubed3/salt
		db_input critical partman-scubed3/iterations
		db_go || return 1
		db_get partman-scubed3/salt
		salt="$RET"
		db_get partman-scubed3/iterations
		iterations="$RET"
	fi

	cat > $S3CONF <<EOF
# scubed3 KDF parameters (see the README of scubed3), made by the
# debian-installer; KEEP A COPY: without the salt the partitions cannot be
# opened
kdf=PBKDF2-SHA256
${salt:+salt=$salt}
iterations=${iterations:-$S3DEFAULT_ITERATIONS}
# the paranoia level that mount, mke2fs and luksformat require
paranoia=2
# the names of the LUKS volumes: /dev/mapper/$(s3_hostname)-NAME
luks_prefix=$(s3_hostname)-
EOF
	echo $base > $S3STATE/base

	if ! s3_start $base; then
		s3_error partman-scubed3/start_failed
		rm -f $S3STATE/base
		return 1
	fi

	db_metaget partman-scubed3/text/in_use description
	partman_lock_unit $(mapdevfs $base) "$RET"
	return 0
}

do_create () {
	local name blocks free bytes mib
	db_set partman-scubed3/name ""
	db_fset partman-scubed3/name seen false
	db_input critical partman-scubed3/name
	db_go || return 0
	db_get partman-scubed3/name
	name="$RET"
	if ! s3_valid_name "$name"; then
		note partman-scubed3/bad_name
		return 0
	fi
	if [ -e $S3MNT/$name ] || [ -d $S3STATE/parts/$name ]; then
		db_subst partman-scubed3/name_exists NAME "$name"
		note partman-scubed3/name_exists
		return 0
	fi

	free=$(s3_p_number "blocks unclaimed")
	if [ -z "$free" ] || [ "$free" -lt 2 ]; then
		note partman-scubed3/no_space
		return 0
	fi
	db_subst partman-scubed3/size NAME "$name"
	db_subst partman-scubed3/size MAX "$(s3_mib_of $free) MiB"
	db_set partman-scubed3/size ""
	db_fset partman-scubed3/size seen false
	db_input critical partman-scubed3/size
	db_go || return 0
	db_get partman-scubed3/size
	if ! valid_human "$RET"; then
		note partman-scubed3/bad_size
		return 0
	fi
	bytes=$(human2longint "$RET")
	mib=$(( bytes / 1048576 ))
	blocks=$(s3_blocks_for $mib)
	if [ $blocks -gt $free ]; then
		note partman-scubed3/bad_size
		return 0
	fi

	db_subst partman-scubed3/luks NAME "$name"
	db_set partman-scubed3/luks true
	db_input critical partman-scubed3/luks
	db_go || return 0

	s3_choose_view "$name" || return 0

	# new random keys in the key store, the partition is made with them
	s3ks -c "keys-add $name $VIEW" -c "create $name" < /dev/null
	if [ ! -e $S3MNT/$name ] || ! s3ctl -c "resize $name $blocks"; then
		s3_error partman-scubed3/create_failed "$name"
		return 0
	fi
	mkdir -p $S3STATE/parts/$name
	>$S3STATE/parts/$name/created
	echo $VIEW > $S3STATE/parts/$name/view
	db_get partman-scubed3/luks
	[ "$RET" = true ] && >$S3STATE/parts/$name/luks
	return 0
}

do_open () {
	local name pass luks
	db_set partman-scubed3/name ""
	db_fset partman-scubed3/name seen false
	db_input critical partman-scubed3/name
	db_go || return 0
	db_get partman-scubed3/name
	name="$RET"
	if ! s3_valid_name "$name"; then
		note partman-scubed3/bad_name
		return 0
	fi
	if [ -e $S3MNT/$name ] || [ -d $S3STATE/parts/$name ]; then
		db_subst partman-scubed3/name_exists NAME "$name"
		note partman-scubed3/name_exists
		return 0
	fi

	db_metaget partman-scubed3/text/partition_description description
	s3_ask_passphrase "$(printf "$RET" "$name")" no || return 0
	pass=$PASS
	PASS=
	s3_busy open
	printf '%s\n' "$pass" | s3ctl -c "open $name"
	s3_busy_done
	if [ ! -e $S3MNT/$name ]; then
		pass=
		db_subst partman-scubed3/no_blocks NAME "$name"
		note partman-scubed3/no_blocks
		return 0
	fi

	# a passphrase of its LUKS volume: the LUKS volume gets a new key, in
	# the key store
	luks=
	if cryptsetup isLuks $S3MNT/$name 2>/dev/null; then
		while :; do
			db_metaget partman-scubed3/text/luks_description description
			if ! s3_ask_passphrase "$(printf "$RET" "$name")" no; then
				pass=
				s3ctl -c "close $name"
				return 0
			fi
			s3_luks_check "$PASS" $name && break
			PASS=
			s3_error partman-scubed3/luks_open_failed "$name"
		done
		luks=$PASS
		PASS=
	fi

	if ! s3_choose_view "$name"; then
		pass=; luks=
		s3ctl -c "close $name"
		return 0
	fi
	s3_busy open
	if [ "$luks" ]; then
		printf '%s\n%s\n' "$pass" "$luks" | s3ks -c "keys-import $name $VIEW"
	else
		printf '%s\n' "$pass" | s3ks -c "keys-import $name $VIEW"
	fi
	s3_busy_done
	pass=; luks=
	mkdir -p $S3STATE/parts/$name
	echo $VIEW > $S3STATE/parts/$name/view
	cryptsetup isLuks $S3MNT/$name 2>/dev/null && >$S3STATE/parts/$name/luks
	return 0
}

do_finish () {
	local p name level boot_level free n r view

	# the root file system goes on root, with LUKS (the LUKS volume is
	# the disk that is partitioned next)
	if [ ! -d $S3STATE/parts/root ] || [ ! -f $S3STATE/parts/root/luks ]; then
		note partman-scubed3/no_root
		return 1
	fi

	db_input critical partman-scubed3/level
	db_input critical partman-scubed3/boot_level
	db_go || return 1
	db_get partman-scubed3/level
	level=$RET
	if ! s3ctl -c "paranoia $level"; then
		s3_error partman-scubed3/level_failed
		return 1
	fi
	echo $level > $S3STATE/level
	db_get partman-scubed3/boot_level
	boot_level=$RET
	# luksformat wants the level of paranoia= now (it warns otherwise),
	# the installed system gets the boot level after it
	sed -i "s/^paranoia=.*/paranoia=$level/" $S3CONF

	# lend the unclaimed blocks to root (as reserved blocks: its size does
	# not change)
	free=$(s3_p_number "blocks unclaimed")
	if [ ! -f $S3STATE/parts/root/lent ] && [ "${free:-0}" -gt 0 ]; then
		n=$(s3_info root no_macroblocks)
		r=$(s3_info root reserved_macroblocks)
		if s3ctl -c "resize-internal root $((n + free)) $((r + free))"; then
			echo "$n $r" > $S3STATE/parts/root/lent
		else
			s3_error partman-scubed3/lend_failed root
		fi
	fi

	# LUKS on the partitions that get it (the keys from the key store),
	# the LUKS volumes of the view of the boot passphrase are opened (the
	# others are not used by the installed system)
	if ! s3_cryptsetup; then
		note partman-scubed3/no_cryptsetup
		return 1
	fi
	for p in $S3STATE/parts/*; do
		[ -d "$p" ] || continue
		name=${p##*/}
		[ -f $p/luks ] || continue
		[ -f $p/luks_open ] && continue
		view=$(cat $p/view 2>/dev/null || echo 1)
		if ! cryptsetup isLuks $S3MNT/$name 2>/dev/null; then
			s3_busy luks
			s3ks -c "luksformat $name" < /dev/null
			s3_busy_done
			if ! cryptsetup isLuks $S3MNT/$name 2>/dev/null; then
				s3_error partman-scubed3/luks_failed "$name"
				return 1
			fi
		fi
		[ "$view" = 1 ] || continue
		s3_busy luks
		s3ks -c "luksopen $name" < /dev/null
		s3_busy_done
		if [ ! -b $(s3_luks_dev $name) ]; then
			s3_error partman-scubed3/luks_failed "$name"
			return 1
		fi
		>$p/luks_open
	done
	sed -i "s/^paranoia=.*/paranoia=$boot_level/" $S3CONF
	return 0
}

# the layout of the base device, the partitions and the key store (the
# lines are separated by \n: debconf with the capability escape)
do_layout () {
	db_capb backup align escape
	db_subst partman-scubed3/layout LAYOUT "$(s3_layout)"
	note partman-scubed3/layout
	db_capb backup align
}

if ! s3_math64; then
	note partman-scubed3/no_math64
	exit 0
fi
if ! s3_cryptsetup; then
	note partman-scubed3/no_cryptsetup
	exit 0
fi
mkdir -p $S3STATE/parts

S3VIEWKEYS=
if ! s3_running; then
	setup_store || exit 0
fi
# the key store, its passphrases (again, if Configure scubed3 was chosen
# before)
if [ ! -f $S3KEYS ]; then
	s3_keystore_new || exit 0
elif [ -z "$S3VIEWKEYS" ]; then
	s3_keystore_unlock || exit 0
fi

while :; do
	list=$(s3_partition_list | tr '\n' ';' | sed 's/;$//; s/;/; /g')
	if [ -z "$list" ]; then
		db_metaget partman-scubed3/text/no_partitions description
		list="$RET"
	fi
	db_subst partman-scubed3/mainmenu PARTITIONS "$list"
	db_fset partman-scubed3/mainmenu seen false
	db_input critical partman-scubed3/mainmenu
	db_go || exit 10
	db_get partman-scubed3/mainmenu
	case $RET in
	    create)	do_create ;;
	    open)	do_open ;;
	    layout)	do_layout ;;
	    finish)	do_finish && break ;;
	    *)
		logger -t partman-scubed3 "Unknown selection '$RET'"
		break ;;
	esac
done
S3VIEWKEYS=

stop_parted_server
restart_partman
exit 0
