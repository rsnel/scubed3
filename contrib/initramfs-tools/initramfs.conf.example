# /etc/scubed3/initramfs.conf: root on a scubed3 partition (see README);
# the hook of scubed3 is only active if this file exists, it is copied into
# the initramfs (it is readable by anyone who has the boot partition)

# the base device, by a name that does not change between boots
BASE=/dev/disk/by-partuuid/00000000-0000-0000-0000-000000000000

# root is the partition root of the key store /etc/scubed3.keys (the hook
# copies it into the initramfs); the passphrase is asked as cryptroot asks
# it, "Please unlock disk CRYPTTAB_NAME:" (default: the name of the base
# device and _crypt, as the debian-installer names an encrypted partition)
#CRYPTTAB_NAME=sda5_crypt

# the number of passphrases without root (wrong ones, and the hidden ones)
# before the boot goes on without root, as cryptroot (0: no limit)
#TRIES=3

# options of the daemon: the same -m and -M as always (the sizes are not
# stored), -r KIBPS for paranoia level 3, FUSE options
OPTIONS=""

# the paranoia level after all partitions are opened (default: paranoia= in
# /etc/scubed3.conf, otherwise 2), and the rate of level 3 in KiB/s
#PARANOIA=2
#RATE=800
