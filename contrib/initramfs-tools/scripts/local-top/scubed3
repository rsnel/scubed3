#!/bin/sh
# initramfs-tools local-top script of scubed3: root on a scubed3 partition
# (see README)
#
# the root file system is on the partition "root" of the key store
# (/etc/scubed3.keys, its copy in the initramfs); the boot asks one thing,
# as cryptroot (cryptsetup-initramfs) asks it for an encrypted partition
# (with its askpass, also with plymouth), with its messages, so that it
# looks the same as a root file system on an encrypted partition:
#
#	Please unlock disk NAME:
#	cryptsetup: ERROR: NAME: cryptsetup failed, bad password or options?
#	cryptsetup: NAME: set up successfully
#
# NAME is CRYPTTAB_NAME, by default as the debian-installer names an
# encrypted partition: vda3_crypt for the base device /dev/vda3
#
# 1. the daemon is started on the base device (BASE), as @scubed3: systemd
#    does not kill a process whose argv[0] starts with @ at shutdown (it is
#    a storage daemon for the root file system); it keeps running after the
#    switch to the real root: it opens nothing by its path after its start,
#    its mount point is below /dev and its control socket below /run, the
#    initramfs moves both to the real root
# 2. passphrases of the key store are asked until one has a view with
#    "root"; a passphrase of another view (with hidden partitions) unlocks
#    it, and gets the message of a wrong passphrase: type it first, then
#    the passphrase of root; after TRIES passphrases (default 3, 0: no
#    limit) without root, the message of cryptroot and the boot goes on
#    without a root device (as with cryptroot)
# 3. all partitions of the unlocked views are opened (in paranoia level 2
#    and 3 ALL partitions must be open: all of them must be in the views
#    that are unlocked at boot), and the LUKS volumes of the view of root
#    (/dev/mapper/PREFIXNAME, with their keys from the key store, for
#    /etc/fstab: /home, ...); the copy of the key store is overwritten and
#    removed
# 4. the paranoia level is switched (PARANOIA, or paranoia= in
#    /etc/scubed3.conf, default 2), before anything is written
# 5. ROOT is /dev/mapper/PREFIXroot (root has LUKS on it), otherwise a
#    loop device on root; PREFIX is luks_prefix= of /etc/scubed3.conf (the
#    debian-installer makes it HOSTNAME-, as LVM names HOSTNAME-vg),
#    default scubed3-
#
# the messages of the daemon and of scubed3ctl go to
# /run/initramfs/scubed3.log (after the boot too), not to the console

PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
prereqs)
	prereqs
	exit 0
	;;
esac

. /scripts/functions

[ -f /conf/scubed3.conf ] || exit 0
. /conf/scubed3.conf

MNT=/dev/scubed3fs
SOCK=/run/scubed3/control
KEYS=/conf/scubed3.keys
LOG=/run/initramfs/scubed3.log
ASKPASS=/lib/cryptsetup/askpass

mkdir -p ${LOG%/*}
log() { echo "scubed3: $*" >> $LOG; }
ctl() { /sbin/scubed3ctl -q -YYY "$@"; }

# a message as cryptroot gives it
message() {
	if [ -x /bin/plymouth ] && plymouth --ping; then
		plymouth message --text="cryptsetup: $*"
	else
		echo "cryptsetup: $*" >&2
	fi
}

# a passphrase on stdout (askpass of cryptsetup-initramfs, as cryptroot
# asks it: the console, plymouth, cryptroot-unlock over ssh)
askpass() {
	local p
	if [ -x $ASKPASS ]; then
		$ASKPASS "$1"
		return
	fi
	printf '%s' "$1" >&2
	stty -echo 2> /dev/null
	read -r p
	stty echo 2> /dev/null
	echo >&2
	printf '%s' "$p"
}

if [ -z "$BASE" ]; then
	panic "scubed3: BASE must be set in /etc/scubed3/initramfs.conf"
fi
if [ ! -f $KEYS ]; then
	panic "scubed3: no key store in the initramfs (/etc/scubed3.keys, with the partition root)"
fi

# the base device may appear late
i=0
while [ ! -e "$BASE" ]; do
	[ $i = 0 ] && log "waiting for $BASE"
	i=$((i + 1))
	[ $i -gt 30 ] && panic "scubed3: $BASE does not appear"
	sleep 1
done
name=${CRYPTTAB_NAME:-$(basename "$(readlink -f "$BASE")")_crypt}

modprobe -q fuse 2> /dev/null
modprobe -q loop 2> /dev/null
mkdir -p $MNT

# 1. the daemon (the PATH lookup keeps the name @scubed3 as argv[0])
if ! PATH=/sbin:$PATH @scubed3 -b "$BASE" $OPTIONS $MNT >> $LOG 2>&1; then
	panic "scubed3: the daemon did not start"
fi
i=0
while [ ! -S $SOCK ]; do
	i=$((i + 1))
	[ $i -gt 100 ] && panic "scubed3: the daemon does not listen on $SOCK"
	sleep 0.1 2> /dev/null || sleep 1
done
# the root file system depends on it: never kill it when memory is short
for p in /proc/[0-9]*; do
	if [ "$(cat $p/comm 2> /dev/null)" = "@scubed3" ]; then
		echo -1000 2> /dev/null > $p/oom_score_adj
	fi
done
# the partitions as /run/scubed3/fs/NAME (for /etc/crypttab of the real
# root, if a LUKS volume is not in the key store)
ln -sfn $MNT /run/scubed3/fs

# 2. and 3. one scubed3ctl: it reads the passphrases from one fifo and
# answers on the other (the views stay unlocked), then it opens the
# partitions and the LUKS volumes
PASS=/run/scubed3/pass
ANSWER=/run/scubed3/answer
rm -f $PASS $ANSWER
mkfifo -m 600 $PASS $ANSWER || panic "scubed3: mkfifo"
ctl -K $KEYS -c "unlock-until root" -c open-all -c "luksopen-all root" \
	< $PASS > $ANSWER 2>> $LOG &
ctlpid=$!
exec 3> $PASS 4< $ANSWER

# the answer to a passphrase: found, other (a view without root, or no
# view), fail (root is ambiguous, or scubed3ctl stopped)
answer() {
	local l
	while read -r l <&4; do
		echo "$l" >> $LOG
		case "$l" in
		    '"root" is in view '*' with other keys')
							echo fail; return ;;
		    '"root" is in view '*)		echo found; return ;;
		    'view '*': '*' entries, without '*)	echo other; return ;;
		    'no view for this passphrase')	echo other; return ;;
		esac
	done
	echo fail
}

tries=0
found=
while :; do
	{ askpass "Please unlock disk $name: "; echo; } >&3
	a=$(answer)
	if [ $a = found ]; then
		found=1
		break
	fi
	if [ $a = fail ]; then
		log "root is in two unlocked views with other keys, or scubed3ctl stopped"
		break
	fi
	message "ERROR: $name: cryptsetup failed, bad password or options?"
	tries=$((tries + 1))
	if [ "${TRIES:-3}" -gt 0 ] && [ $tries -ge "${TRIES:-3}" ]; then
		message "ERROR: $name: maximum number of tries exceeded"
		break
	fi
done
# the rest of the output of scubed3ctl (it must not block on a full fifo)
exec 3>&-
cat <&4 >> $LOG
exec 4<&-
wait $ctlpid
rm -f $PASS $ANSWER
dd if=/dev/urandom of=$KEYS bs=$(wc -c < $KEYS) count=1 conv=notrunc 2> /dev/null
rm -f $KEYS

# as cryptroot: without root the boot goes on, the root device does not
# appear
[ "$found" ] || exit 0

if [ ! -e "$MNT/root" ]; then
	message "ERROR: $name: cryptsetup failed, bad password or options?"
	log "the partition root is not opened (see above)"
	exit 0
fi

# the names of the LUKS volumes (as scubed3ctl names them)
prefix=scubed3-
if [ -f /etc/scubed3.conf ] && grep -q '^[[:space:]]*luks_prefix[[:space:]]*=' /etc/scubed3.conf; then
	prefix=$(sed -n 's/^[[:space:]]*luks_prefix[[:space:]]*=[[:space:]]*\([^[:space:]]*\)[[:space:]]*$/\1/p' /etc/scubed3.conf | head -n 1)
fi

# 4. the paranoia level (it shows the open partitions in the log)
level=$PARANOIA
if [ -z "$level" ] && [ -f /etc/scubed3.conf ]; then
	level=$(sed -n 's/^[[:space:]]*paranoia[[:space:]]*=[[:space:]]*\([0-3]\)[[:space:]]*$/\1/p' /etc/scubed3.conf)
fi
[ -z "$level" ] && level=2
# (the daemon starts in level 1)
if [ "$level" != 1 ]; then
	ctl -c "paranoia $level${RATE:+ $RATE}" >> $LOG 2>&1
fi
if ! ctl -c p 2>> $LOG | tee -a $LOG | grep -q "paranoia level $level "; then
	echo "scubed3: WARNING: the paranoia level is not $level, what is written now" >&2
	echo "scubed3: shows which blocks belong to which partition" >&2
fi

# 5. the block device of the root partition
if [ -b /dev/mapper/${prefix}root ]; then
	dev=/dev/mapper/${prefix}root
elif [ -x /sbin/cryptsetup ] && /sbin/cryptsetup isLuks "$MNT/root"; then
	# (its LUKS key is not in the key store: cryptsetup asks)
	dev=/dev/mapper/${prefix}root
	i=0
	until /sbin/cryptsetup open "$MNT/root" ${prefix}root; do
		i=$((i + 1))
		[ $i -ge 3 ] && panic "scubed3: the LUKS volume on root is not opened"
	done
else
	dev=$(/sbin/losetup-util -f --show "$MNT/root") ||
		panic "scubed3: no loop device for root"
fi
message "$name: set up successfully"
log "the root file system is on $dev"
echo "ROOT=$dev" >> /conf/param.conf

exit 0
